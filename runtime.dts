		status = "okay";
		io-channels = <0x86 0x01 0x86 0x03>;
		io-channel-names = "lsbord_id1", "lsboard_id0";
	};

	lsec_lbm: lsec-lbm {
		compatible = "lsec,lsec_lbm";
		status = "okay";
		lsec-vbus-en = <0x20 0x3e 0x00>;
		lsec-hub-en = <0x20 0x3b 0x00>;
		lsec-usb3-en = <0x20 0x6b 0x00>;
