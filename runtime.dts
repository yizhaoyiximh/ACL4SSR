	sipc: sipc-virt {
		compatible = "unisoc,sipc-virt-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phandle = <0x1e7>;

		sipc_pm: core@6 {
			compatible = "sprd,sipc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x06>;
			label = "sipc-pmsys";
			mboxes = <0x10b 0x01 0x00>;
			sprd,smem-info = <0x65007400 0x65007400 0x1000>;
			phandle = <0x1e8>;

			slog_pm: channel@5 {
				compatible = "sprd,spipe";
				reg = <0x05>;
				label = "slog_pm";
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x5c0>;
				sprd,size-txbuf = <0x00>;
				phandle = <0x1e9>;
			};

			sctl_pm: channel@6 {
				compatible = "sprd,spipe";
				reg = <0x06>;
				label = "sctl_pm";
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x40>;
				sprd,size-txbuf = <0x20>;
				phandle = <0x1ea>;
			};
		};

		sipc_ch: core@9 {
			compatible = "sprd,sipc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x09>;
			label = "sipc-chsys";
			mboxes = <0x10b 0x02 0x00 0x10b 0x06 0x01>;
			sprd,smem-info = <0x6500d000 0x6500d000 0x2000 0xae600000 0x80000000 0x40000>;
			phandle = <0x1eb>;

			spipe_ch: channel@4 {
				compatible = "sprd,spipe";
				reg = <0x04>;
				label = "spipe_ch";
				sprd,ringnr = <0x02>;
				sprd,size-rxbuf = <0xb00>;
				sprd,size-txbuf = <0x180>;
				phandle = <0x1ec>;
			};

			slog_ch: channel@5 {
				compatible = "sprd,spipe";
				reg = <0x05>;
				label = "slog_ch";
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x4e0>;
				sprd,size-txbuf = <0x00>;
				phandle = <0x1ed>;
			};

			sctl_ch: channel@6 {
				compatible = "sprd,spipe";
				reg = <0x06>;
				label = "sctl_ch";
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x40>;
				sprd,size-txbuf = <0x20>;
				phandle = <0x1ee>;
			};

			data0_gnss: channel@7 {
				compatible = "sprd,spipe";
				reg = <0x07>;
				label = "data0_gnss";
				sprd,smem = <0x01>;
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x20000>;
				sprd,size-txbuf = <0x18000>;
				phandle = <0x1ef>;
			};

			stime_ch: channel@41 {
				compatible = "sprd,spipe";
				reg = <0x29>;
				label = "stime_ch";
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x40>;
				sprd,size-txbuf = <0x80>;
				phandle = <0x1f0>;
			};
		};

		sipc_pscp: core@5 {
			compatible = "sprd,sipc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x05>;
			label = "sipc-pscp";
			mboxes = <0x10b 0x03 0x00>;
			sprd,smem-info = <0x87800000 0x87800000 0x400000>;
			phandle = <0x1f1>;

			imsbr_data: channel@2 {
				compatible = "sprd,spool";
				reg = <0x02>;
				label = "imsbr_data";
				sprd,tx-blksize = <0x5f4>;
				sprd,tx-blknum = <0x40>;
				sprd,rx-blksize = <0x5f4>;
				sprd,rx-blknum = <0x40>;
				phandle = <0x1f2>;
			};

			imsbr_ctrl: channel@3 {
				compatible = "sprd,spool";
				reg = <0x03>;
				label = "imsbr_ctrl";
				sprd,tx-blksize = <0x80>;
				sprd,tx-blknum = <0x40>;
				sprd,rx-blksize = <0x80>;
				sprd,rx-blknum = <0x40>;
				phandle = <0x1f3>;
			};

			spipe_nr: channel@4 {
				compatible = "sprd,spipe";
				reg = <0x04>;
				label = "spipe_nr";
				sprd,ringnr = <0x14>;
				sprd,size-rxbuf = <0x1000>;
				sprd,size-txbuf = <0x1000>;
				phandle = <0x1f4>;
			};

			sdiag_nr: channel@21 {
				compatible = "sprd,spipe";
				reg = <0x15>;
				label = "sdiag_nr";
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x40000>;
				sprd,size-txbuf = <0x8000>;
				phandle = <0x1f5>;
			};

			stty_nr: channel@6 {
				compatible = "sprd,spipe";
				reg = <0x06>;
				label = "stty_nr";
				sprd,ringnr = <0x20>;
				sprd,size-rxbuf = <0x800>;
				sprd,size-txbuf = <0x800>;
				phandle = <0x1f6>;
			};

			snv_nr: channel@40 {
				compatible = "sprd,spipe";
				reg = <0x28>;
				label = "snv_nr";
				sprd,ringnr = <0x01>;
				sprd,size-rxbuf = <0x40400>;
				sprd,size-txbuf = <0x1000>;
				phandle = <0x1f7>;
			};

			slog_nr: channel@5 {
				compatible = "sprd,spool";
				reg = <0x05>;
				label = "slog_nr";
				sprd,preconfigured = <0x01>;
				sprd,tx-blksize = <0x00>;
				sprd,tx-blknum = <0x00>;
				sprd,rx-blksize = <0x800>;
				sprd,rx-blknum = <0x3e8>;
				phandle = <0x1f8>;
			};
		};

		sipc_phycp: core@7 {
			compatible = "sprd,sipc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x07>;
			label = "sipc-phycp";
			mboxes = <0x10b 0x04 0x00>;
			sprd,smem-info = <0x87c00000 0x87c00000 0x400000>;
			phandle = <0x1f9>;

			slog_phy: channel@5 {
				compatible = "sprd,spool";
				reg = <0x05>;
				label = "slog_phy";
				sprd,preconfigured = <0x01>;
				sprd,tx-blksize = <0x00>;
				sprd,tx-blknum = <0x00>;
				sprd,rx-blksize = <0x2000>;
				sprd,rx-blknum = <0x1f4>;
				phandle = <0x1fa>;
			};
		};

		sbridge_log: sbridge@0 {
			compatible = "sprd,slog_bridge";
			sprd,tx_is_usb = <0x01>;
			sprd,tx_dst = <0x00>;
			sprd,rx_dst = <0x05 0x07>;
			sprd,priority = <0x56>;
			phandle = <0x1fb>;
		};

		time_sync {
			compatible = "sprd,time-sync";
		};
	};

	sprd_pcm: sprd-pcm-audio {
