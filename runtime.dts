			adi_bus: spi@400000 {
				compatible = "sprd,qogirn6pro-adi";
				reg = <0x400000 0x100000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				sprd,hw-channels = <0x02 0x20cc 0x09 0x2074 0x0b 0x2054 0x0d 0xa180 0x0f 0xa054 0x11 0xa1a0 0x13 0xa044 0x15 0xa0e8 0x17 0x244c 0x19 0xa074 0x1b 0x2044 0x1e 0x2020 0x20 0x217c 0x21 0x2188 0x22 0x21b8 0x23 0x21ac>;
				phandle = <0x1a1>;

				ump9620_pmic: pmic@0 {
					compatible = "sprd,ump9620";
					reg = <0x00>;
					spi-max-frequency = <0x18cba80>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0xe6 0x04>;
					phandle = <0x7c>;

					pmic_wdt: watchdog@40 {
						compatible = "sprd,ump9620-wdt", "sprd,sc27xx-wdt";
						reg = <0x40>;
						phandle = <0x1a2>;
					};

					led-controller@180 {
						compatible = "sprd,ump9620-bltc", "sprd,sc27xx-bltc";
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						reg = <0x180>;

						led@0 {
							label = "red";
							reg = <0x00>;
						};

						led@1 {
							label = "green";
							reg = <0x01>;
						};

						led@2 {
							label = "blue";
							reg = <0x02>;
						};
					};

					rtc@200 {
						compatible = "sprd,ump96xx-rtc", "sprd,sc27xx-rtc";
						reg = <0x200>;
						interrupt-parent = <0x7c>;
						interrupts = <0x01 0x04>;
					};

					pmic_eic: gpio@280 {
						compatible = "sprd,ump96xx-eic", "sprd,sc27xx-eic", "sprd,sc2731-eic";
						reg = <0x280>;
						interrupt-parent = <0x7c>;
						interrupts = <0x04 0x04>;
						gpio-controller;
						#gpio-cells = <0x02>;
						interrupt-controller;
						#interrupt-cells = <0x02>;
						phandle = <0x84>;
					};

					pmic_fchg: fchg@400 {
						compatible = "sprd,ump9620-fast-chg", "sprd,sc27xx-fast-chg";
						reg = <0x400>;
						interrupt-parent = <0x7c>;
						interrupts = <0x05 0x04>;
						nvmem-cell-names = "fchg_cur_calib";
						nvmem-cells = <0x7d>;
						status = "okay";
						sprd,input-voltage-microvolt = <0x4c4b40>;
						phandle = <0x1a3>;
					};

					pmic_adc: adc@504 {
						compatible = "sprd,ump9620-adc", "sprd,sc27xx-adc";
						reg = <0x504>;
						interrupt-parent = <0x7c>;
						interrupts = <0x00 0x04>;
						sprd_adc_pm_reg = <0x02 0x350 0x100>;
						#io-channel-cells = <0x01>;
						hwlocks = <0x6c 0x04>;
						nvmem-cells = <0x7e 0x7f 0x80 0x81 0x82 0x83>;
						nvmem-cell-names = "big_scale_calib1", "big_scale_calib2", "small_scale_calib1", "small_scale_calib2", "vbat_det_cal1", "vbat_det_cal2";
						phandle = <0x86>;
					};

					pmic_fgu: fgu@800 {
						compatible = "sprd,ump9620-fgu", "sprd,sc27xx-fgu";
						reg = <0x800>;
						bat-detect-gpio = <0x84 0x03 0x00>;
						nvmem-cell-names = "fgu_calib";
						nvmem-cells = <0x85>;
						io-channels = <0x86 0x00 0x86 0x0e>;
						io-channel-names = "bat-temp", "charge-vol";
						interrupt-parent = <0x7c>;
						interrupts = <0x03 0x04>;
						status = "disabled";
						monitored-battery = <0x27>;
						sprd,calib-resistance-micro-ohms = <0x12f2>;
						sprd,comp-resistance-mohm = <0x0b>;
						fgu-capacity-track;
						phys = <0x61>;
						sprd,relax-counter-threshold = <0x244>;
						sprd,relax-current-threshold = <0x1e>;
						sprd,capacity-sleep-calibration;
						sprd,capacity-boot-calibration;
						sprd,capacity-charge-cycle;
						sprd,basp;
						phandle = <0x1a4>;
					};

					ump9620_efuse: efuse@c00 {
						compatible = "sprd,ump9620-efuse", "sprd,sc27xx-efuse";
						reg = <0xc00>;
						#address-cells = <0x01>;
						#size-cells = <0x01>;
						hwlocks = <0x6c 0x0c>;
						phandle = <0x1a5>;

						adc_bcal1: calib@38 {
							reg = <0x38 0x02>;
							phandle = <0x7e>;
						};

						adc_bcal2: calib@3a {
							reg = <0x3a 0x02>;
							phandle = <0x7f>;
						};

						adc_scal1: calib@42 {
							reg = <0x42 0x02>;
							phandle = <0x80>;
						};

						adc_scal2: calib@40 {
							reg = <0x40 0x02>;
							phandle = <0x81>;
						};

						vbat_det_cal1: calib@46 {
							reg = <0x46 0x02>;
							phandle = <0x82>;
						};

						vbat_det_cal2: calib@44 {
							reg = <0x44 0x02>;
							phandle = <0x83>;
						};

						typec_cc1_cal: calib@1b {
							reg = <0x36 0x02>;
							phandle = <0x87>;
						};

						typec_cc2_cal: calib@1c {
							reg = <0x37 0x02>;
							phandle = <0x88>;
						};

						fgu_calib: calib@4 {
							reg = <0x4c 0x02>;
							phandle = <0x85>;
						};

						neg_cp_efuse: calib@32 {
							reg = <0x32 0x02>;
							phandle = <0x90>;
						};

						headset_adc_fir: calib@4a {
							reg = <0x4a 0x02>;
							phandle = <0x7d>;
						};

						headset_adc_fir_1: calib@3c {
							reg = <0x3c 0x02>;
							phandle = <0x119>;
						};

						headset_adc_fir_2: calib@3e {
							reg = <0x3e 0x02>;
							phandle = <0x11a>;
						};

						headset_adc_sec: calib@2e {
							reg = <0x2e 0x02>;
							phandle = <0x11b>;
						};

						pddelta_calib: calib@48 {
							reg = <0x48 0x02>;
							phandle = <0x8a>;
						};

						pdrc_calib: calib@2c {
							reg = <0x2c 0x02>;
							phandle = <0x89>;
						};
					};

					pmic_typec: typec@380 {
						compatible = "sprd,ump96xx-typec", "sprd,sc27xx-typec";
						interrupt-parent = <0x7c>;
						interrupts = <0x08 0x04>;
						reg = <0x380>;
						sprd,mode = <0x02>;
						nvmem-cells = <0x87 0x88>;
						nvmem-cell-names = "typec_cc1_cal", "typec_cc2_cal";
						phandle = <0x6b>;
					};

					pmic_pd: pd@e00 {
						compatible = "sprd,sc27xx-pd", "sprd,ump9620-pd";
						reg = <0xe00 0x380>;
						interrupt-parent = <0x7c>;
						interrupts = <0x09 0x04>;
						extcon = <0x6b>;
						nvmem-cells = <0x89 0x8a>;
						nvmem-cell-names = "pdrc_calib", "pddelta_calib";
						status = "okay";
						sprd,syscon-aon-apb = <0x02>;
						vbus-supply = <0x8b>;
						vconn-supply = <0x8c>;
						phandle = <0x60>;

						usb_con: connector {
							compatible = "usb-c-connector";
							label = "USB-C";
							power-role = "dual";
							try-power-role = "sink";
							source-pdos = <0x401912c>;
							sink-pdos = <0x401912c 0xc0dc213c>;
							op-sink-microwatt = <0x989680>;
							phandle = <0x1a6>;
						};
					};

					sprd_audio_codec_ana: audio-codec@1000 {
						compatible = "unisoc,ump9620-audio-codec", "sprd,sc27xx-audio-codec";
						#sound-dai-cells = <0x01>;
						reg = <0x1000>;
						sprd,syscon-pmu-apb = <0x04>;
						sprd,syscon-aon-apb = <0x02>;
						clk26m_sinout_pmic_en = <0x02 0x350 0x40>;
						sprd,syscon-agcp-apb = <0x8d>;
						sprd,syscon-audaon-clk = <0x8e>;
						sprd,syscon-dvfs-apb = <0x8f>;
						nvmem-cells = <0x90 0x85>;
						nvmem-cell-names = "neg_cp_efuse", "fgu_4p2_efuse";
						status = "okay";
						hp-use-inter-pa = <0x01>;
						fixed-sample-rate = <0xbb80 0xbb80 0xbb80>;
						digital-codec = <0x91>;
						set-offset = <0x1000>;
						clr-offset = <0x2000>;
						lrdat-sel = <0x01>;
						phandle = <0x122>;
					};

					syscon@2000 {
						compatible = "sprd,ump962x-syscon";
						reg = <0x2000 0x23a0 0x2398>;
					};

					pmic_smpl: smpl@2000 {
						compatible = "sprd,ump9620-smpl", "sprd,sc27xx-smpl";
						reg = <0x2000>;
						sprd,smpl-timer-threshold = <0xfa>;
						phandle = <0x1a7>;
					};

					power-controller@2000 {
						compatible = "sprd,ump962x-regulator", "sprd,sc27xx-regulator";

						vddcpu2: DCDC_CPU2 {
							regulator-name = "vddcpu2";
