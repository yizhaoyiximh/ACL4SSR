	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0xf2>;
				};

				core1 {
					cpu = <0xf4>;
				};

				core2 {
					cpu = <0xf6>;
				};

				core3 {
					cpu = <0xf8>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0xfa>;
				};

				core1 {
					cpu = <0xfc>;
				};

				core2 {
					cpu = <0xfe>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x100>;
				};
			};
		};

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x110 0x111>;
			capacity-dmips-mhz = <0x1a1>;
			dynamic-power-coefficient = <0x9b>;
			cpufreq-data-v1 = <0x112>;
			#cooling-cells = <0x02>;
			sugov_slack_timer;
			phandle = <0xf2>;
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x110 0x111>;
			capacity-dmips-mhz = <0x1a1>;
			dynamic-power-coefficient = <0x9b>;
			cpufreq-data-v1 = <0x112>;
			phandle = <0xf4>;
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x110 0x111>;
			capacity-dmips-mhz = <0x1a1>;
			dynamic-power-coefficient = <0x9b>;
			cpufreq-data-v1 = <0x112>;
			phandle = <0xf6>;
		};

		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55", "arm,armv8";
			reg = <0x00 0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x110 0x111>;
			capacity-dmips-mhz = <0x1a1>;
			dynamic-power-coefficient = <0x9b>;
			cpufreq-data-v1 = <0x112>;
			phandle = <0xf8>;
		};

		CPU4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a76", "arm,armv8";
			reg = <0x00 0x400>;
			enable-method = "psci";
			cpu-idle-states = <0x113 0x111>;
			capacity-dmips-mhz = <0x3fe>;
			dynamic-power-coefficient = <0x2d1>;
			cpufreq-data-v1 = <0x114>;
			#cooling-cells = <0x02>;
			phandle = <0xfa>;
		};

		CPU5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a76", "arm,armv8";
			reg = <0x00 0x500>;
			enable-method = "psci";
			cpu-idle-states = <0x113 0x111>;
